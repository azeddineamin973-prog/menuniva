# ---------------------------------------------------------------------------
# MenuNiva environment configuration
# Copy this file to `.env` and fill in values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Which environment this is: development | test | demo | staging | production
APP_ENV=development

# Public base URL of the app (used for QR codes, canonical URLs, emails)
APP_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Local development uses `npm run db:local` (embedded PostgreSQL on port 5433).
LOCAL_PG_PORT=5433
LOCAL_PG_PASSWORD=change-me-to-a-random-local-password
DATABASE_URL=postgresql://menuniva:change-me-to-a-random-local-password@127.0.0.1:5433/menuniva_dev
# Used by automated tests only (data is wiped between test runs)
TEST_DATABASE_URL=postgresql://menuniva:change-me-to-a-random-local-password@127.0.0.1:5433/menuniva_test
# Separate demo database with clearly labelled fake data
DEMO_DATABASE_URL=postgresql://menuniva:change-me-to-a-random-local-password@127.0.0.1:5433/menuniva_demo

# --- Security --------------------------------------------------------------
# 32+ random bytes, used to sign customer order-tracking tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-32-random-bytes

# --- File uploads ----------------------------------------------------------
# Local folder for uploaded logos/photos in development (git-ignored).
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=5242880

# --- Optional integrations (leave empty = feature shows "Needs configuration")
# Translation provider. Supported: none | deepl | libretranslate
TRANSLATION_PROVIDER=none
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Email (password reset, staff invitations). Empty = links are shown to the admin instead of emailed.
SMTP_URL=
EMAIL_FROM=

# Glovo / Uber Eats official partner APIs (require approval from each provider)
GLOVO_PARTNER_API_KEY=
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=

# SaaS billing: manual (today). No processor is integrated yet.
BILLING_PROVIDER=manual
# Backups (npm run backup): target folder and how many to keep
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Error monitoring (optional): an https endpoint that receives each server error as a JSON POST
# (personal data scrubbed). Errors are always stored in the ErrorLog table as well.
ERROR_MONITORING_DSN=
