// MenuNiva data model
// ---------------------------------------------------------------------------
// Conventions
// - Every tenant-owned row carries `organizationId` so queries can always be
//   scoped to the authorised tenant (see src/server/tenant.ts).
// - Money is stored as integer minor units (euro cents) in `*Cents` columns.
//   No floating-point arithmetic is used for authoritative totals.
// - Order lines store immutable snapshots (names, unit prices, modifiers) so
//   historical orders never change when menu prices change.
// - IDs are stable random CUIDs. Public URLs never use raw IDs as credentials;
//   QR codes and tracking links use separate random tokens.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================== ENUMS ======================================

enum PlatformRole {
  USER
  PLATFORM_SUPER_ADMIN
}

enum MembershipRole {
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  WAITER
  KITCHEN_STAFF
  CAFE_STAFF
  DELIVERY_STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum LanguageCode {
  pt
  en
  fr
  ar
  es
}

enum CountryCode {
  PT
  ES
}

enum OrganizationStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PriceChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderChannel {
  TABLE
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD_TERMINAL
  PAY_AT_COUNTER
  CASH_ON_DELIVERY
  OTHER_MANUAL
}

enum PaymentRecordStatus {
  RECORDED
  VOIDED
}

enum PrepStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum StationType {
  KITCHEN
  CAFE
  DESSERTS
  DRINKS
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TranslationStatus {
  SOURCE // original text written by the restaurant
  MACHINE // generated by a provider, NOT yet reviewed
  REVIEWED // reviewed/edited by restaurant staff
}

enum AllergenCode {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOYBEANS
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

enum AllergenPresence {
  CONTAINS
  MAY_CONTAIN
}

enum DataOrigin {
  MANUAL
  IMPORTED
  AI_SUGGESTED
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum StaffTaskType {
  CALL_WAITER
  REQUEST_BILL
}

enum StaffTaskStatus {
  OPEN
  ACKNOWLEDGED
  DONE
}

enum ImportSourceType {
  GLOVO
  UBER_EATS
  CSV
  XLSX
  PDF
  IMAGE
  TEXT
  MANUAL
}

enum ImportJobStatus {
  DRAFT
  NEEDS_REVIEW
  PUBLISHED
  CANCELLED
  FAILED
}

enum ExtractionMethod {
  STRUCTURED_FILE
  NATIVE_TEXT
  OCR
  AI_ASSISTED
  PARTNER_API
  MANUAL_PASTE
}

enum ImportDecisionType {
  CREATE
  MERGE_INTO_EXISTING
  MERGE_WITH_IMPORTED
  SKIP
}

enum IntegrationStatus {
  NOT_CONFIGURED
  LIMITED
  CONNECTED
  ERROR
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  COMBO
}

enum ReservationStatus {
  REQUESTED
  CONFIRMED
  REJECTED
  CANCELLED
  ARRIVED
  NO_SHOW
  COMPLETED
}

enum FeedbackCategoryCode {
  FOOD_QUALITY
  SERVICE
  WAITING_TIME
  CLEANLINESS
  VALUE
  DELIVERY
  OTHER
}

enum FeedbackStatus {
  NEW
  INVESTIGATING
  RESOLVED
  ARCHIVED
}

enum LoyaltyProgramType {
  POINTS
  STAMPS
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

// ============================== IDENTITY ===================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String
  platformRole  PlatformRole @default(USER)
  preferredLanguage LanguageCode @default(pt)
  emailVerifiedAt DateTime?
  disabledAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions      Session[]
  memberships   RestaurantMembership[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique // SHA-256 of the random cookie token; raw token never stored
  activeOrganizationId String?
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time token used to create the first platform super admin.
model PlatformSetupToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole
  locationIds    String[]
  tokenHash      String         @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ============================== TENANCY ====================================

model RestaurantOrganization {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  legalName         String?
  taxId             String?
  country           CountryCode        @default(PT)
  currency          String             @default("EUR")
  defaultLanguage   LanguageCode       @default(pt)
  sourceLanguage    LanguageCode       @default(pt)
  enabledLanguages  LanguageCode[]     @default([pt, en, fr, ar, es])
  status            OrganizationStatus @default(ONBOARDING)
  isDemo            Boolean            @default(false) // demo tenants hold clearly labelled fake data
  onboardingStep    Int                @default(1)
  onboardingData    Json?
  enabledModules    String[]           @default([]) // add-on modules switched on by Super Admin beyond the plan
  disabledModules   String[]           @default([]) // plan modules switched off by Super Admin for this tenant
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  branding          RestaurantBranding?
  settings          RestaurantSettings?
  subscription      Subscription?
  locations         RestaurantLocation[]
  memberships       RestaurantMembership[]
  invitations       Invitation[]
  menus             Menu[]
  categories        MenuCategory[]
  products          MenuProduct[]
  taxClasses        TaxClass[]
  importJobs        ImportJob[]
  orders            Order[]
  promotions        Promotion[]
  feedback          CustomerFeedback[]
  loyaltyProgram    LoyaltyProgram?
  loyaltyAccounts   LoyaltyAccount[]
  upsellRules       UpsellRule[]
  integrations      IntegrationConnection[]
  supportTickets    SupportTicket[]
  auditLogs         AuditLog[]
}

model RestaurantBranding {
  id             String  @id @default(cuid())
  organizationId String  @unique
  logoUrl        String?
  coverUrl       String?
  themePreset    String  @default("classic") // e.g. "moroccan", "classic", "minimal"
  primaryColor   String  @default("#1F5C4A")
  accentColor    String  @default("#B8975A")
  backgroundColor String @default("#FBF7EE")
  textColor      String  @default("#1E2420")
  headingFont    String  @default("serif")
  tagline        String?

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model RestaurantSettings {
  id                   String  @id @default(cuid())
  organizationId       String  @unique
  orderAlertsMuted     Boolean @default(false)
  requireOrderAcceptance Boolean @default(true)
  feedbackEnabled      Boolean @default(true)
  upsellEnabled        Boolean @default(true)
  pricesIncludeTax     Boolean @default(true)
  dataRetentionDays    Int     @default(730) // customer contact data retention for closed orders
  allergyNotice        Json?   // per-language notice text written by the restaurant

  organization         RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model RestaurantLocation {
  id              String      @id @default(cuid())
  organizationId  String
  slug            String
  name            String
  addressLine1    String?
  addressLine2    String?
  city            String?
  postalCode      String?
  country         CountryCode @default(PT)
  phone           String?
  whatsappNumber  String?
  email           String?
  timeZone        String      @default("Europe/Lisbon")
  openingHours    Json?       // { mon: [{open:"12:00",close:"15:00"}], ... } confirmed by restaurant
  websiteUrl      String?
  instagramUrl    String?
  facebookUrl     String?
  tiktokUrl       String?
  glovoUrl        String?
  uberEatsUrl     String?
  tableOrderingEnabled Boolean @default(false)
  takeawayEnabled Boolean     @default(false)
  deliveryEnabled Boolean     @default(false)
  reservationsEnabled Boolean @default(false)
  whatsappOrderingEnabled Boolean @default(false)
  orderingPaused  Boolean     @default(false)
  tableCodeRequired Boolean   @default(false) // guests must enter a code given by staff before ordering
  isPublished     Boolean     @default(false)
  publishedAt     DateTime?
  orderSequence   Int         @default(0) // atomic counter for human-friendly order numbers
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  diningAreas     DiningArea[]
  tables          RestaurantTable[]
  stations        KitchenStation[]
  orders          Order[]
  deliveryZones   DeliveryZone[]
  takeawaySettings TakeawaySettings?
  deliverySettings DeliverySettings?
  reservationSettings ReservationSettings?
  reviewSettings  ReviewSettings?
  reservations    Reservation[]
  productOverrides ProductLocationOverride[]
  staffTasks      StaffTask[]
  tableSessions   TableSession[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model RestaurantMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  locationIds    String[]         @default([]) // empty = all locations
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     DeliveryOrderDetails[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ============================== SUBSCRIPTIONS ==============================

model SubscriptionPlan {
  id            String   @id @default(cuid())
  code          String   @unique // starter | growth | pro | enterprise
  name          String
  description   String?
  monthlyPriceCents Int?  // null = custom pricing; values are configurable, not final
  yearlyPriceCents  Int?
  currency      String   @default("EUR")
  limits        Json     // { locations: 1, tables: 30, staff: 10, menuItems: 300 }
  features      String[] // module keys enabled by this plan
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIALING)
  billingPeriod    BillingPeriod      @default(MONTHLY)
  trialEndsAt      DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  pendingPlanId    String?            // prepared upgrade/downgrade
  provider         String             @default("manual")
  externalId       String?
  suspendedReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization     RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan       @relation(fields: [planId], references: [id])
  billingRecords   BillingRecord[]
}

// Only genuine billing events (manual invoices recorded by platform admin or verified webhooks).
model BillingRecord {
  id             String   @id @default(cuid())
  subscriptionId String
  amountCents    Int
  currency       String   @default("EUR")
  periodStart    DateTime
  periodEnd      DateTime
  status         String   // RECORDED_MANUALLY | PAID_VIA_PROVIDER | VOIDED
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ============================== MENU =======================================

model TaxClass {
  id             String      @id @default(cuid())
  organizationId String
  country        CountryCode
  name           String      // e.g. "IVA intermédia (restauração)" — chosen/approved by restaurant
  rateBasisPoints Int        // 1300 = 13.00 %
  approvedAt     DateTime?
  createdAt      DateTime    @default(now())

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       MenuProduct[]

  @@index([organizationId])
}

model Menu {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories     MenuCategory[]
  products       MenuProduct[]

  @@index([organizationId])
}

model MenuCategory {
  id               String   @id @default(cuid())
  organizationId   String
  menuId           String
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  defaultStationId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu             Menu                   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  defaultStation   KitchenStation?        @relation(fields: [defaultStationId], references: [id], onDelete: SetNull)
  translations     CategoryTranslation[]
  products         MenuProduct[]
  schedules        AvailabilitySchedule[]

  @@index([organizationId, menuId])
}

model CategoryTranslation {
  id          String            @id @default(cuid())
  categoryId  String
  language    LanguageCode
  name        String
  description String?
  status      TranslationStatus
  updatedAt   DateTime          @updatedAt

  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
}

model MenuProduct {
  id                 String        @id @default(cuid())
  organizationId     String
  menuId             String
  categoryId         String
  stationId          String?       // preparation station (overrides category default)
  taxClassId         String?
  status             ProductStatus @default(DRAFT)
  soldOut            Boolean       @default(false) // temporary, all locations
  isFeatured         Boolean       @default(false)
  isPopular          Boolean       @default(false)
  tags               String[]      @default([])
  sortOrder          Int           @default(0)
  allergensVerifiedAt DateTime?    // set only when staff explicitly verify allergen data
  allergensVerifiedById String?
  origin             DataOrigin    @default(MANUAL)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization       RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu               Menu                   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category           MenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  station            KitchenStation?        @relation(fields: [stationId], references: [id], onDelete: SetNull)
  taxClass           TaxClass?              @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  translations       ProductTranslation[]
  images             ProductImage[]
  variants           ProductVariant[]
  modifierGroups     ModifierGroup[]
  allergens          ProductAllergenDeclaration[]
  prices             ChannelPrice[]
  locationOverrides  ProductLocationOverride[]
  externalPrices     ExternalSourcePrice[]
  schedules          AvailabilitySchedule[]

  @@index([organizationId, menuId, categoryId])
  @@index([organizationId, status])
}

model ProductTranslation {
  id          String            @id @default(cuid())
  productId   String
  language    LanguageCode
  name        String
  description String?
  ingredients String?
  status      TranslationStatus
  updatedAt   DateTime          @updatedAt

  product     MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
}

model ProductImage {
  id             String   @id @default(cuid())
  productId      String
  url            String
  altText        String?
  sortOrder      Int      @default(0)
  rightsConfirmed Boolean @default(false) // restaurant confirms it may publish this image
  origin         DataOrigin @default(MANUAL)
  createdAt      DateTime @default(now())

  product        MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  names           Json     // { pt: "Pequeno", en: "Small" }
  priceDeltaCents Int      @default(0)
  isDefault       Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  sortOrder       Int      @default(0)

  product         MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ModifierGroup {
  id          String   @id @default(cuid())
  productId   String
  names       Json
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  sortOrder   Int      @default(0)

  product     MenuProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  options     ModifierOption[]

  @@index([productId])
}

model ModifierOption {
  id              String  @id @default(cuid())
  groupId         String
  names           Json
  priceDeltaCents Int     @default(0)
  maxQuantity     Int     @default(1)
  isAvailable     Boolean @default(true)
  sortOrder       Int     @default(0)

  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ProductAllergenDeclaration {
  id          String           @id @default(cuid())
  productId   String
  allergen    AllergenCode
  presence    AllergenPresence
  origin      DataOrigin       @default(MANUAL)
  verifiedAt  DateTime?
  verifiedById String?
  createdAt   DateTime         @default(now())

  product     MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, allergen])
}

// Restaurant-controlled base price per channel (all locations).
model ChannelPrice {
  id          String       @id @default(cuid())
  productId   String
  channel     PriceChannel
  amountCents Int
  updatedAt   DateTime     @updatedAt

  product     MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
}

// Location-specific availability and price overrides (null price = inherit base price).
model ProductLocationOverride {
  id                 String   @id @default(cuid())
  productId          String
  locationId         String
  isAvailable        Boolean  @default(true)
  soldOut            Boolean  @default(false)
  dineInPriceCents   Int?
  takeawayPriceCents Int?
  deliveryPriceCents Int?
  updatedAt          DateTime @updatedAt

  product            MenuProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  location           RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([locationId])
}

// Prices captured from Glovo/Uber Eats imports — reference data only, never used for MenuNiva orders.
model ExternalSourcePrice {
  id          String           @id @default(cuid())
  productId   String
  provider    ImportSourceType
  amountCents Int
  currency    String           @default("EUR")
  externalId  String?
  capturedAt  DateTime         @default(now())

  product     MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, provider])
}

model AvailabilitySchedule {
  id          String  @id @default(cuid())
  productId   String?
  categoryId  String?
  dayOfWeek   Int     // 0 = Sunday … 6 = Saturday, in the location's time zone
  startMinute Int     // minutes after midnight
  endMinute   Int

  product     MenuProduct?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([categoryId])
}

// ============================== IMPORT STUDIO ==============================

model ImportJob {
  id             String          @id @default(cuid())
  organizationId String
  menuId         String?
  status         ImportJobStatus @default(DRAFT)
  sourceLanguage LanguageCode    @default(pt)
  createdById    String
  summary        Json?
  publishedAt    DateTime?
  publishedById  String?
  cancelledAt    DateTime?
  createdProductIds String[]     @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources        ImportSource[]
  products       ImportedProduct[]
  mappings       ImportMapping[]
  decisions      ImportReviewDecision[]

  @@index([organizationId, status])
}

model ImportSource {
  id               String           @id @default(cuid())
  jobId            String
  type             ImportSourceType
  url              String?
  fileName         String?
  extractionMethod ExtractionMethod?
  connectionStatus IntegrationStatus @default(NOT_CONFIGURED)
  status           String           @default("PENDING") // PENDING | PARSED | FAILED | UNSUPPORTED
  errorMessage     String?
  createdAt        DateTime         @default(now())

  job              ImportJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  products         ImportedProduct[]

  @@index([jobId])
}

model ImportedProduct {
  id           String   @id @default(cuid())
  jobId        String
  sourceId     String
  categoryName String?
  name         String
  description  String?
  imageUrl     String?
  priceCents   Int?
  currency     String?
  variants     Json?
  modifiers    Json?
  available    Boolean?
  externalId   String?
  warnings     String[] @default([])
  raw          Json?
  rowNumber    Int?

  job          ImportJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source       ImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  decisions    ImportReviewDecision[]

  @@index([jobId])
}

// Suggested duplicate groups (across sources or against existing products).
model ImportMapping {
  id                String   @id @default(cuid())
  jobId             String
  importedProductIds String[]
  existingProductId String?
  confidence        Int      // 0-100
  reason            String

  job               ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ImportReviewDecision {
  id                String             @id @default(cuid())
  jobId             String
  importedProductId String
  decision          ImportDecisionType
  targetProductId   String?
  mergeGroupKey     String?
  isCanonical       Boolean            @default(false)
  decidedById       String
  createdAt         DateTime           @default(now())

  job               ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  importedProduct   ImportedProduct @relation(fields: [importedProductId], references: [id], onDelete: Cascade)

  @@unique([jobId, importedProductId])
}

// ============================== TABLES & QR ================================

model DiningArea {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  floor          String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  location       RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tables         RestaurantTable[]

  @@index([organizationId, locationId])
}

model RestaurantTable {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  areaId         String?
  label          String
  seats          Int?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  location       RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  area           DiningArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  qrTokens       TableQRToken[]
  sessions       TableSession[]
  orders         Order[]
  staffTasks     StaffTask[]
  reservationAssignments ReservationTableAssignment[]

  @@unique([locationId, label])
  @@index([organizationId])
}

model TableQRToken {
  id        String    @id @default(cuid())
  tableId   String
  token     String    @unique // random, unguessable, printed in the QR URL
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  table     RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

model TableSession {
  id             String             @id @default(cuid())
  organizationId String
  locationId     String
  tableId        String
  status         TableSessionStatus @default(OPEN)
  verificationCode String?          // optional short code staff can tell guests
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  closedById     String?
  closeNote      String?
  openedById     String?

  location       RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table          RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders         Order[]
  staffTasks     StaffTask[]

  @@index([organizationId, locationId, status])
  @@index([tableId, status])
}

// ============================== KITCHEN ====================================

model KitchenStation {
  id             String      @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  type           StationType @default(KITCHEN)
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  location       RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  products       MenuProduct[]
  categories     MenuCategory[]
  tickets        KitchenTicket[]
  orderItems     OrderItem[]

  @@index([organizationId, locationId])
}

// ============================== ORDERS =====================================

model Order {
  id               String        @id @default(cuid())
  organizationId   String
  locationId       String
  number           Int           // per-location sequence
  channel          OrderChannel
  status           OrderStatus   @default(NEW)
  paymentStatus    PaymentStatus @default(UNPAID)
  tableId          String?
  tableSessionId   String?
  customerName     String?
  customerPhone    String?
  customerNotes    String?
  language         LanguageCode  @default(pt)
  pickupAt         DateTime?
  subtotalCents    Int
  discountCents    Int           @default(0)
  deliveryFeeCents Int           @default(0)
  totalCents       Int
  paidCents        Int           @default(0)
  paymentMethodIntent PaymentMethod? // how the guest said they will pay (informational)
  loyaltyAccountId String?       // set only when the guest voluntarily joins loyalty from this order
  currency         String        @default("EUR")
  idempotencyKey   String
  trackingTokenHash String       @unique
  acknowledgedAt   DateTime?
  acceptedAt       DateTime?
  readyAt          DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location         RestaurantLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table            RestaurantTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession     TableSession?          @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  events           OrderStatusEvent[]
  tickets          KitchenTicket[]
  delivery         DeliveryOrderDetails?
  discounts        OrderDiscount[]
  payments         PaymentRecord[]
  feedback         CustomerFeedback[]
  loyaltyAccount   LoyaltyAccount?        @relation(fields: [loyaltyAccountId], references: [id], onDelete: SetNull)

  @@unique([locationId, idempotencyKey])
  @@unique([locationId, number])
  @@index([organizationId, locationId, status])
  @@index([organizationId, createdAt])
  @@index([tableSessionId])
}

model OrderItem {
  id                 String     @id @default(cuid())
  orderId            String
  organizationId     String
  productId          String?
  variantId          String?
  stationId          String?
  nameSnapshot       String     // name in restaurant source language at submission
  customerNameSnapshot String?  // name as shown to the customer in their language
  variantNameSnapshot String?
  unitPriceCents     Int        // base + variant, snapshot
  modifiersUnitCents Int        @default(0)
  quantity           Int
  lineTotalCents     Int
  notes              String?
  prepStatus         PrepStatus @default(PENDING)
  voidedAt           DateTime?
  voidedById         String?
  voidReason         String?
  createdAt          DateTime   @default(now())

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station            KitchenStation?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  modifiers          OrderItemModifier[]
  allocations        PaymentAllocation[]

  @@index([orderId])
  @@index([organizationId, productId])
  @@index([stationId, prepStatus])
}

model OrderItemModifier {
  id              String  @id @default(cuid())
  orderItemId     String
  optionId        String?
  groupNameSnapshot String
  nameSnapshot    String
  priceDeltaCents Int
  quantity        Int     @default(1)

  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   ActorType
  actorUserId String?
  note        String?
  createdAt   DateTime     @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model KitchenTicket {
  id             String     @id @default(cuid())
  organizationId String
  orderId        String
  stationId      String
  status         PrepStatus @default(PENDING)
  createdAt      DateTime   @default(now())
  startedAt      DateTime?
  readyAt        DateTime?
  printedAt      DateTime?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station        KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([orderId, stationId])
  @@index([stationId, status])
}

model StaffTask {
  id             String          @id @default(cuid())
  organizationId String
  locationId     String
  tableId        String?
  tableSessionId String?
  type           StaffTaskType
  status         StaffTaskStatus @default(OPEN)
  note           String?
  createdAt      DateTime        @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  doneAt         DateTime?

  location       RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table          RestaurantTable?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession   TableSession?      @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, locationId, status])
}

// ============================== PAYMENTS ===================================

model PaymentRecord {
  id             String              @id @default(cuid())
  organizationId String
  orderId        String
  amountCents    Int
  method         PaymentMethod
  status         PaymentRecordStatus @default(RECORDED)
  provider       String              @default("manual")
  externalRef    String?
  note           String?
  recordedById   String?
  voidedById     String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime            @default(now())

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations    PaymentAllocation[]

  @@index([organizationId, createdAt])
  @@index([orderId])
}

// Split bills: which items (and how much) a payment covers.
model PaymentAllocation {
  id          String @id @default(cuid())
  paymentId   String
  orderItemId String
  amountCents Int

  payment     PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderItemId])
}

// ============================== TAKEAWAY & DELIVERY ========================

model TakeawaySettings {
  id              String  @id @default(cuid())
  locationId      String  @unique
  leadTimeMinutes Int     @default(20)
  slotMinutes     Int     @default(15)
  minOrderCents   Int     @default(0)
  pickupHours     Json?   // same format as openingHours; null = use opening hours
  paused          Boolean @default(false)

  location        RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model DeliverySettings {
  id                   String  @id @default(cuid())
  locationId           String  @unique
  prepEstimateMinutes  Int     @default(25)
  deliveryEstimateMinutes Int  @default(30)
  maxActiveOrders      Int     @default(10)
  deliveryHours        Json?
  cashOnDeliveryEnabled Boolean @default(true)
  cardOnDeliveryEnabled Boolean @default(false) // driver carries the restaurant's card terminal
  paused               Boolean @default(false)

  location             RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id                     String   @id @default(cuid())
  organizationId         String
  locationId             String
  name                   String
  postalCodePatterns     String[] // e.g. "4700-*", "4700-123", "4710"
  feeCents               Int
  minOrderCents          Int      @default(0)
  freeDeliveryThresholdCents Int?
  estimatedMinutes       Int?
  isActive               Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())

  location               RestaurantLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  deliveries             DeliveryOrderDetails[]

  @@index([organizationId, locationId])
}

model DeliveryOrderDetails {
  id              String    @id @default(cuid())
  orderId         String    @unique
  zoneId          String?
  recipientName   String
  addressLine     String
  postalCode      String
  city            String
  phone           String
  notes           String?
  driverMembershipId String?
  outForDeliveryAt DateTime?
  deliveredAt     DateTime?

  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zone            DeliveryZone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  driver          RestaurantMembership? @relation(fields: [driverMembershipId], references: [id], onDelete: SetNull)
}

// ============================== PROMOTIONS =================================

model Promotion {
  id               String         @id @default(cuid())
  organizationId   String
  locationIds      String[]       @default([]) // empty = all locations
  name             String
  description      Json?          // per-language customer text
  type             PromotionType
  percentBasisPoints Int?         // 1000 = 10 %
  amountCents      Int?
  buyQuantity      Int?
  getQuantity      Int?
  comboPriceCents  Int?
  productIds       String[]       @default([])
  categoryIds      String[]       @default([])
  channels         OrderChannel[] @default([TABLE, TAKEAWAY, DELIVERY])
  minOrderCents    Int            @default(0)
  usageLimit       Int?
  usageCount       Int            @default(0)
  priority         Int            @default(0)
  combinable       Boolean        @default(false)
  requiresCode     Boolean        @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coupons          Coupon[]
  orderDiscounts   OrderDiscount[]

  @@index([organizationId, isActive])
}

model Coupon {
  id          String   @id @default(cuid())
  organizationId String
  promotionId String
  code        String
  usageLimit  Int?
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
}

model OrderDiscount {
  id          String  @id @default(cuid())
  orderId     String
  promotionId String?
  couponCode  String?
  description String
  amountCents Int

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([promotionId])
}

// ============================== RESERVATIONS ===============================

model ReservationSettings {
  id                 String  @id @default(cuid())
  locationId         String  @unique
  slotMinutes        Int     @default(30)
  durationMinutes    Int     @default(90)
  bufferMinutes      Int     @default(15)
  maxPartySize       Int     @default(8)
  maxCoversPerSlot   Int     @default(20)
  minNoticeMinutes   Int     @default(60)
  maxDaysAhead       Int     @default(60)
  bookableHours      Json?   // null = use opening hours

  location           RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Reservation {
  id             String            @id @default(cuid())
  organizationId String
  locationId     String
  startsAt       DateTime
  endsAt         DateTime
  partySize      Int
  name           String
  phone          String
  email          String?
  specialRequest String?
  status         ReservationStatus @default(REQUESTED)
  language       LanguageCode      @default(pt)
  trackingTokenHash String         @unique
  idempotencyKey String
  internalNote   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  location       RestaurantLocation           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignments    ReservationTableAssignment[]

  @@unique([locationId, idempotencyKey])
  @@index([organizationId, locationId, startsAt])
}

model ReservationTableAssignment {
  id            String   @id @default(cuid())
  reservationId String
  tableId       String
  startsAt      DateTime
  endsAt        DateTime // includes buffer

  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table         RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([reservationId, tableId])
  @@index([tableId, startsAt, endsAt])
}

// ============================== REVIEWS ====================================

model ReviewSettings {
  id                String  @id @default(cuid())
  locationId        String  @unique
  googleReviewUrl   String? // official URL configured by the restaurant; shown to ALL customers equally
  lowRatingThreshold Int    @default(3) // ratings <= this create a manager alert (internal only)

  location          RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model CustomerFeedback {
  id             String                 @id @default(cuid())
  organizationId String
  locationId     String
  orderId        String?
  rating         Int                    // 1-5
  comment        String?
  categories     FeedbackCategoryCode[] @default([])
  wantsFollowUp  Boolean                @default(false)
  contactName    String?
  contactInfo    String?                // only when the customer asks for follow-up
  language       LanguageCode           @default(pt)
  status         FeedbackStatus         @default(NEW)
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes          FeedbackInternalNote[]

  @@index([organizationId, locationId, createdAt])
  @@index([organizationId, status])
}

model FeedbackInternalNote {
  id         String   @id @default(cuid())
  feedbackId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  feedback   CustomerFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

// ============================== LOYALTY ====================================

model LoyaltyProgram {
  id                String             @id @default(cuid())
  organizationId    String             @unique
  enabled           Boolean            @default(false)
  type              LoyaltyProgramType @default(STAMPS)
  pointsPerEuro     Int                @default(1)
  stampsForReward   Int                @default(10)
  rewardDescription Json?
  expiryDays        Int?

  organization      RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model LoyaltyAccount {
  id             String    @id @default(cuid())
  organizationId String
  phone          String
  name           String?
  balance        Int       @default(0)
  marketingOptIn Boolean   @default(false) // separate from operational contact
  marketingOptInAt DateTime?
  birthday       String?   // "MM-DD", only with explicit consent
  consentAt      DateTime
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]
  orders         Order[]

  @@unique([organizationId, phone])
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  accountId String
  orderId   String?
  type      LoyaltyTransactionType
  amount    Int
  note      String?
  expiresAt DateTime?
  createdAt DateTime               @default(now())

  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([orderId])
}

// ============================== UPSELL =====================================

model UpsellRule {
  id                 String   @id @default(cuid())
  organizationId     String
  triggerProductId   String?
  triggerCategoryId  String?
  suggestedProductId String
  priority           Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  organization       RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events             UpsellEvent[]

  @@index([organizationId, isActive])
}

model UpsellEvent {
  id             String   @id @default(cuid())
  organizationId String
  ruleId         String
  eventType      String   // SHOWN | ACCEPTED
  orderId        String?
  createdAt      DateTime @default(now())

  rule           UpsellRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ============================== PLATFORM ===================================

model IntegrationConnection {
  id             String            @id @default(cuid())
  organizationId String
  provider       String            // GLOVO | UBER_EATS | TRANSLATION | PAYMENTS | INVOICING | PRINTER
  status         IntegrationStatus @default(NOT_CONFIGURED)
  note           String?
  lastCheckedAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  locationId     String?
  type           String    // NEW_ORDER | STAFF_TASK | LOW_RATING | RESERVATION_REQUEST
  title          String
  body           String?
  link           String?
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, readAt, createdAt])
}

model SupportTicket {
  id             String   @id @default(cuid())
  organizationId String?
  subject        String
  body           String
  status         String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   RestaurantOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
}

model PlatformConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  context   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String   // e.g. "order.status_changed", "platform.tenant_suspended"
  entityType     String
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization   RestaurantOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

// Fixed-window rate limiter stored in PostgreSQL (works with multiple app instances).
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}
