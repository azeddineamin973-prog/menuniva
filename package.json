{
  "name": "menuniva",
  "version": "0.1.0",
  "private": true,
  "description": "MenuNiva — One Menu. Every Order. Every Language. Multi-tenant restaurant SaaS.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/db-local.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup:admin-token": "tsx --conditions=react-server scripts/create-setup-token.ts",
    "setup:casa": "tsx --conditions=react-server scripts/bootstrap-casa-de-marrocos.ts",
    "demo:seed": "tsx --conditions=react-server scripts/seed-demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "fflate": "0.8.3",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "unpdf": "2.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
