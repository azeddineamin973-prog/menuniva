# dependencies
node_modules/

# build output
.next/
.next-e2e/
.next-demo/
.next-ux/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# generated code
src/generated/

# local database files (embedded PostgreSQL data directory)
.data/

# uploads stored locally in development
storage/

# environment files with secrets (keep .env.example)
.env
.env.*
!.env.example

# test output
test-results/
playwright-report/
coverage/

# logs and OS files
*.log
.DS_Store
# database backups contain personal data — never commit
/backups/
# audit artifacts that may contain database copies
/audit/backups/
/audit/logs/
/audit/artifacts/
/audit/ux/out/
# database CA certificates (downloaded, environment-specific)
/certs/
